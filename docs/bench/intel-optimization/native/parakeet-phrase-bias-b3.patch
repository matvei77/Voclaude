+// Phrase matcher for PhraseBias: active partial matches over the raw target
+// strings, advanced by the raw piece of every emitted token.
+class PhraseMatcher {
+  public:
+    explicit PhraseMatcher(const PhraseBias & b) : b_(b) {}
+
+    // True if `piece` continues an active match, or opens a target at a step
+    // where the acoustic best piece `acoustic` also opens a word with the same
+    // first-letter case. A start piece other than the acoustic best needs at
+    // least two characters after the marker. These rules keep the bias from
+    // turning a mid-word step into a word start ("Hemen Gwei"), from changing
+    // case ("git" -> "Git"), and from committing to a one-letter prefix of a
+    // target that the audio will not complete.
+    bool extends(const std::string & piece, const std::string * acoustic) const {
+        if (piece.empty()) {
+            return false;
+        }
+        for (const Active & a : active_) {
+            if (continues(b_.targets[static_cast<size_t>(a.target)], a.off, piece)) {
+                return true;
+            }
+        }
+        if (!may_start(piece, acoustic)) {
+            return false;
+        }
+        for (const std::string & t : b_.targets) {
+            if (continues(t, 0, piece)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // Advance with an emitted piece. `end_frame` is the frame the emitted
+    // token ends at (step_at_emit + duration): the gap timeout counts from it,
+    // so TDT duration jumps inside a word do not drop the match.
+    void advance(const std::string & piece, int end_frame) {
+        const int step = end_frame;
+        std::vector<Active> next;
+        for (const Active & a : active_) {
+            const std::string & t = b_.targets[static_cast<size_t>(a.target)];
+            if (continues(t, a.off, piece) && a.off + piece.size() < t.size()) {
+                next.push_back({ a.target, a.off + piece.size(), step });
+            }
+        }
+        if (opens_word(piece)) {
+            for (size_t i = 0; i < b_.targets.size(); ++i) {
+                if (continues(b_.targets[i], 0, piece) && piece.size() < b_.targets[i].size()) {
+                    next.push_back({ static_cast<int>(i), piece.size(), step });
+                }
+            }
+        }
+        active_.swap(next);
+    }
+
+    bool active() const { return !active_.empty(); }
+
+    // Drop matches that made no progress for more than max_gap_frames.
+    void tick(int step) {
+        size_t k = 0;
+        for (const Active & a : active_) {
+            if (step - a.last_step <= b_.max_gap_frames) {
+                active_[k++] = a;
+            }
+        }
+        active_.resize(k);
+    }
+
+  private:
+    struct Active {
+        int    target;
+        size_t off;
+        int    last_step;
+    };
+
+    // A word-initial piece with at least one character after the marker (the
+    // bare marker piece is a prefix of every target and is never boosted).
+    static bool opens_word(const std::string & piece) {
+        return piece.size() > 3 && std::memcmp(piece.data(), "\xE2\x96\x81", 3) == 0;
+    }
+
+    static int letter_case(unsigned char c) {
+        return (c >= 'A' && c <= 'Z') ? 1 : (c >= 'a' && c <= 'z') ? 0 : 2;  // 2: not ASCII
+    }
+
+    static bool may_start(const std::string & piece, const std::string * acoustic) {
+        if (!opens_word(piece) || acoustic == nullptr || !opens_word(*acoustic)) {
+            return false;
+        }
+        if (piece == *acoustic) {
+            return true;
+        }
+        return piece.size() >= 5 &&  // marker (3 bytes) + at least 2 characters
+               letter_case(static_cast<unsigned char>(piece[3])) ==
+                   letter_case(static_cast<unsigned char>((*acoustic)[3]));
+    }
+
+    static bool continues(const std::string & target, size_t off, const std::string & piece) {
+        return off + piece.size() <= target.size() && target.compare(off, piece.size(), piece) == 0;
+    }
+
+    const PhraseBias &  b_;
+    std::vector<Active> active_;
+};
+
+// Token for a non-blank step under PhraseBias: the best of the top_k
+// acoustic non-blank tokens after the bonus. `acoustic_best` is the unbiased
+// argmax (non-blank, so it is among the top_k). Ties keep the acoustic order.
+int phrase_biased_token(const float * token_logits, int n_token_cls, int blank_id, int acoustic_best,
+                        PhraseBias & bias, const PhraseMatcher & matcher, std::vector<int> & scratch_top) {
+    const int k = std::max(1, std::min(bias.top_k, n_token_cls - 1));
+    scratch_top.clear();
+    for (int i = 0; i < n_token_cls; ++i) {
+        if (i == blank_id) {
+            continue;
+        }
+        if (static_cast<int>(scratch_top.size()) < k) {
+            scratch_top.push_back(i);
+        } else if (token_logits[i] > token_logits[scratch_top.back()]) {
+            scratch_top.back() = i;
+        } else {
+            continue;
+        }
+        // Keep scratch_top sorted by logit, descending (stable for ties).
+        for (size_t j = scratch_top.size() - 1; j > 0 && token_logits[scratch_top[j]] > token_logits[scratch_top[j - 1]];
+             --j) {
+            std::swap(scratch_top[j], scratch_top[j - 1]);
+        }
+    }
+    // scratch_top[0] is acoustic_best (ties keep the first index in both).
+    auto piece_of = [&](int id) -> const std::string * {
+        return (id >= 0 && id < static_cast<int>(bias.pieces.size())) ? bias.pieces[static_cast<size_t>(id)] : nullptr;
+    };
+    const std::string * acoustic   = piece_of(acoustic_best);
+    int                 best       = acoustic_best;
+    float               best_score = -INFINITY;
+    bool                any_boost  = false;
+    for (int id : scratch_top) {
+        const std::string * piece   = piece_of(id);
+        const bool          boosted = piece != nullptr && matcher.extends(*piece, acoustic);
+        const float score   = token_logits[id] + (boosted ? bias.bonus : 0.0f);
+        any_boost           = any_boost || boosted;
+        if (score > best_score) {
+            best_score = score;
+            best       = id;
+        }
+    }
+    if (any_boost) {
+        ++bias.boosted_steps;
+    }
+    if (best != acoustic_best) {
+        ++bias.flips;
+    }
+    if (bias.trace && (any_boost || matcher.active())) {
+        std::string line;
+        for (int id : scratch_top) {
+            const std::string * piece =
+                (id < static_cast<int>(bias.pieces.size())) ? bias.pieces[static_cast<size_t>(id)] : nullptr;
+            char buf[160];
+            std::snprintf(buf, sizeof(buf), " %s%s=%.2f", (piece != nullptr && matcher.extends(*piece, acoustic)) ? "+" : "",
+                          piece != nullptr ? piece->c_str() : "<special>", token_logits[id]);
+            line += buf;
+        }
+        const std::string * chosen =
+            (best < static_cast<int>(bias.pieces.size())) ? bias.pieces[static_cast<size_t>(best)] : nullptr;
+        log_msg(TRANSCRIBE_LOG_LEVEL_INFO, "phrase-trace: pick %s |%s", chosen != nullptr ? chosen->c_str() : "?",
+                line.c_str());
+    }
+    return best;
+}
+
 }  // namespace
 
