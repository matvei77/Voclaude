@@ -1168,6 +1360,12 @@ transcribe_status decode_tdt_greedy(const HostDecoderWeights & w,
             tok.step_at_emit    = step;
             tok.duration_frames = duration;
             out_tokens.push_back(tok);
+            if (matcher) {
