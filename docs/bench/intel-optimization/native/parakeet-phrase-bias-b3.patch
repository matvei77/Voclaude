     if (iter >= max_iters && !global_budget) {
         log_msg(TRANSCRIBE_LOG_LEVEL_ERROR,
diff --git a/src/arch/parakeet/decoder.h b/src/arch/parakeet/decoder.h
index e7cb70a..9b81fe4 100644
--- a/src/arch/parakeet/decoder.h
+++ b/src/arch/parakeet/decoder.h
@@ -203,6 +203,31 @@ struct TdtToken {
     int   duration_frames = 0;
 };
 
+// Optional phrase bias for decode_tdt_greedy (RunOptions::vocabulary).
+//
+// Bounded shallow fusion over SentencePiece piece text, not token ids (the
+// SentencePiece tokenizer has no encoder here, and a phrase can be spelled by
+// several piece sequences). At a step where the acoustic argmax is NOT blank,
+// the top_k acoustic tokens are re-ranked: a token whose raw piece continues a
+// target (or starts one at a word boundary) gets `bonus` added to its logit.
+// Blank decisions, durations and the reported entropy confidence all come from
+// the unbiased logits, so the bias can only change WHICH token is emitted at a
+// step the model already chose to emit, and only among its own top_k guesses
+// within `bonus` logits of the best one. A partial match is dropped after
+// `max_gap_frames` encoder frames without progress or at a word boundary that
+// does not continue it.
+struct PhraseBias {
+    std::vector<std::string>         targets;  // raw form: U+2581 + words joined by U+2581
+    std::vector<const std::string *> pieces;   // raw piece per token id; nullptr = never boosted
+    float                            bonus          = 4.0f;  // logits (2026-11-08 sweep: 4 = 6 > 2 on accepted fixes)
+    int                              top_k          = 8;
+    int                              max_gap_frames = 3;
+    bool                             trace          = false;  // log every biased step (evaluation only)
+    // Telemetry (written by the decoder).
+    int boosted_steps = 0;  // steps where at least one candidate got the bonus
+    int flips         = 0;  // steps where the emitted token differs from the acoustic argmax
+};
+
 // Run TDT greedy decode end-to-end against an encoder output buffer.
 //
 // Inputs:
@@ -223,7 +248,8 @@ transcribe_status decode_tdt_greedy(const HostDecoderWeights & w,
                                     int                        T_enc,
                                     int                        d_enc,
                                     int                        n_threads,
-                                    std::vector<TdtToken> &    out_tokens);
+                                    std::vector<TdtToken> &    out_tokens,
+                                    PhraseBias *               bias = nullptr);
 
 // Run RNNT greedy decode end-to-end. Same predictor + joint code as TDT,
 // but the joint emits `vocab+1` logits (no duration extras) and the step
diff --git a/src/arch/parakeet/model.cpp b/src/arch/parakeet/model.cpp
index a877781..c3b8127 100644
--- a/src/arch/parakeet/model.cpp
+++ b/src/arch/parakeet/model.cpp
@@ -587,6 +587,12 @@ transcribe_status load(Loader & loader, const transcribe_model_load_params * par
         return st;
     }
 
+    // RunOptions::vocabulary drives the bounded phrase bias of the offline
+    // TDT greedy decoder (decoder.h PhraseBias). Other heads ignore it.
+    if (m->host_decoder.head_kind == HostHeadKind::TDT) {
+        transcribe::set_feature(m.get(), TRANSCRIBE_FEATURE_VOCABULARY, true);
+    }
+
     // Multitalker bundle post-load: fuse the diarizer conformer's BN (needs
     // uploaded data), build its ceil-framed mel frontend, and publish the
     // DIARIZATION capability — for a bundle it is a property of the file.
@@ -789,6 +795,61 @@ static double parakeet_ms_per_enc_frame(const ParakeetHParams & hp) {
            static_cast<double>(hp.fe_sample_rate);
 }
 
+// PhraseBias for one run from RunOptions::vocabulary: each term becomes a raw
+// SentencePiece target ("Claude Code" -> U+2581 "Claude" U+2581 "Code"), and
+// every non-special piece of the vocabulary can be boosted. Tuning overrides
+// for evaluation only: TRANSCRIBE_PARAKEET_BIAS_BONUS / _TOPK / _GAP.
+static bool build_phrase_bias(const ParakeetModel * pm, const transcribe_run_params * params, PhraseBias & out) {
+    if (params == nullptr || params->vocabulary == nullptr || params->n_vocabulary <= 0) {
+        return false;
+    }
+    constexpr const char k_marker[] = "\xE2\x96\x81";
+    for (int32_t i = 0; i < params->n_vocabulary; ++i) {
+        const char * term = params->vocabulary[i];
+        if (term == nullptr) {
+            continue;
+        }
+        std::string target;
+        bool        at_word_start = true;
+        for (const char * c = term; *c != '\0'; ++c) {
+            if (*c == ' ' || *c == '\t' || *c == '\n' || *c == '\r') {
+                at_word_start = true;
+                continue;
+            }
+            if (at_word_start) {
+                target += k_marker;
+                at_word_start = false;
+            }
+            target += *c;
+        }
+        if (!target.empty()) {
+            out.targets.push_back(std::move(target));
+        }
+    }
+    if (out.targets.empty()) {
+        return false;
+    }
+    const transcribe::Tokenizer & tok = pm->tok;
+    const int                     n   = tok.n_tokens();
+    out.pieces.assign(static_cast<size_t>(std::max(n, 0)), nullptr);
+    for (int id = 0; id < n; ++id) {
+        if (!is_strippable_special(tok, id)) {
+            out.pieces[static_cast<size_t>(id)] = &tok.token(id);
+        }
+    }
+    if (const char * v = transcribe::env::str("TRANSCRIBE_PARAKEET_BIAS_BONUS")) {
+        out.bonus = static_cast<float>(std::atof(v));
+    }
+    if (const char * v = transcribe::env::str("TRANSCRIBE_PARAKEET_BIAS_TOPK")) {
+        out.top_k = std::max(1, std::atoi(v));
+    }
+    if (const char * v = transcribe::env::str("TRANSCRIBE_PARAKEET_BIAS_GAP")) {
+        out.max_gap_frames = std::max(0, std::atoi(v));
+    }
+    out.trace = transcribe::env::flag("TRANSCRIBE_PARAKEET_BIAS_TRACE");
+    return true;
+}
+
 // Host-side TDT/RNNT/CTC decode + public result-hierarchy build for one
 // utterance's encoder output. `enc` is the row-major [T_enc, d_enc]
 // activation for ONE utterance; utt_index >= 0 tags the per-utterance
@@ -826,9 +887,13 @@ static transcribe_status decode_and_populate(ParakeetSession *             pc,
     {
         transcribe_status st = TRANSCRIBE_OK;
         switch (pm->host_decoder.head_kind) {
-            case HostHeadKind::TDT:
-                st = decode_tdt_greedy(pm->host_decoder, enc, T_enc, d_enc, pc->n_threads, pc->raw_tokens);
+            case HostHeadKind::TDT: {
+                PhraseBias bias;
+                const bool biased = build_phrase_bias(pm, params, bias);
+                st = decode_tdt_greedy(pm->host_decoder, enc, T_enc, d_enc, pc->n_threads, pc->raw_tokens,
+                                       biased ? &bias : nullptr);
                 break;
+            }
             case HostHeadKind::RNNT:
                 st = decode_rnnt_greedy(pm->host_decoder, enc, T_enc, d_enc, pc->n_threads, pc->raw_tokens);
                 break;
