+                                                bias->pieces[static_cast<size_t>(pred_token)] :
+                                                nullptr;
+                matcher->advance(piece != nullptr ? *piece : std::string(), step + duration);
+            }
 
             last_token = pred_token;
             std::swap(state, next_state);  // commit
@@ -1214,6 +1412,12 @@ transcribe_status decode_tdt_greedy(const HostDecoderWeights & w,
             iter, static_cast<int>(out_tokens.size()), T_enc, t_enc_proj_us / 1000.0, t_pred_us / 1000.0,
